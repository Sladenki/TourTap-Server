NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/tour-tap

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Необязательно. Список origin через запятую. Если пусто, в development отражаются любые origin.
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# NestJS Observe. Для локальной разработки можно оставить пустым.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
